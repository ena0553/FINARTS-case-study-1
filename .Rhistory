knitr::opts_chunk$set(
echo = TRUE,
message = FALSE,
warning = FALSE,
comment = "",
fig.path = "04_Figures/generated-",
fig.align = "center"
)
options(xts.warn_dplyr_breaks_lag = FALSE)
suppressWarnings(
suppressPackageStartupMessages({
library(tidyverse)
library(quantmod)
library(lubridate)
library(flextable)
library(broom)
library(scales)
library(zoo)
library(lmtest)
library(sandwich)
})
)
cobalt_kable <- function(x, caption = NULL, digits = 4) {
is_knitting <- !is.null(knitr::opts_knit$get("rmarkdown.pandoc.to"))
if (!is_knitting) {
knitr::kable(
x, digits = digits, caption = caption,
format = "html",
table.attr = 'style="color:#FFFFFF !important; background-color:transparent !important;"'
)
} else if (knitr::is_html_output()) {
knitr::kable(
x, digits = digits, caption = caption,
format = "html",
table.attr = 'style="color:#222222 !important; background-color:transparent !important;"'
)
} else {
knitr::kable(
x, digits = digits, caption = caption,
format = "latex",
booktabs = FALSE
)
}
}
research_flextable <- function(x) {
flextable(x) |>
theme_vanilla() |>
bold(part = "header") |>
fontsize(size = 9.5, part = "all") |>
align(align = "left", part = "all") |>
valign(valign = "center", part = "all") |>
autofit()
}
variable_dictionary <- tribble(
~`#`, ~Candidate_Regressor,                 ~Dataset_Code,                  ~Transformation,           ~Source,                        ~Route,
0,    "BDO monthly log return (DEPENDENT)", "BDO_Return",                   "Monthly log return",      "Yahoo Finance (BDO.PS)",       "Download",
1,    "PSEi return",                        "PSEi_Return",                  "Monthly log return",      "Yahoo Finance (PSEI.PS)",      "Download",
2,    "BSP RRP rate change",                "BSP_RRP_Change",               "Month-end first difference", "BSP",                         "Local CSV",
3,    "PH 10Y gov't-yield change",          "PH_10Y_Change",                "Month-end first difference", "Instructor-supplied",         "Local CSV",
4,    "USD/PHP change",                     "USD_PHP_Change",               "Monthly log change",      "BSP monthly FX / Yahoo (PHP=X)", "Download",
5,    "CPI inflation",                      "PH_CPI_YoY",                   "YoY % change",            "PSA OpenSTAT",                 "Local CSV",
6,    "M3 growth",                          "PH_M3_YoY",                    "YoY % growth",            "BSP Domestic Liquidity",       "Local CSV",
7,    "OFW remittance growth",              "PH_OFW_Remittances_YoY",       "YoY % growth",            "BSP OF remittances",           "Local CSV",
8,    "Manufacturing-production growth",    "PH_Manufacturing_Production_YoY", "YoY % growth",         "PSA MISSI",                    "Local CSV",
9,    "WTI return",                         "WTI_Return",                   "Monthly log return",      "FRED DCOILWTICO",              "Download",
10,   "VIX",                                "VIX",                          "Monthly average",         "FRED VIXCLS",                  "Download"
)
variable_dictionary |>
research_flextable()
download_from <- as.Date("2018-01-01")
download_to   <- as.Date("2025-12-31")
# Local file holding the BSP / PSA / instructor-supplied monthly series
local_file <- file.path(data_dir, "case-study-data.csv")
download_from <- as.Date("2018-01-01")
download_to   <- as.Date("2025-12-31")
# Local file holding the BSP / PSA / instructor-supplied monthly series
local_file <- file.path("case-study-data.csv")
safe_get <- function(symbol, src) {
tryCatch(
suppressWarnings(
getSymbols(symbol, src = src,
from = download_from, to = download_to,
auto.assign = FALSE)
),
error = function(e) {
message("Download failed for ", symbol, " (", src, "): ", conditionMessage(e))
NULL
}
)
}
# Use the adjusted close when it exists (equities); otherwise the close (index, FX).
price_series <- function(x) {
if (is.null(x)) return(NULL)
if (has.Ad(x)) Ad(x) else Cl(x)
}
bdo_raw    <- safe_get("BDO.PS",  "yahoo")   # BDO Unibank
psei_raw   <- safe_get("PSEI.PS", "yahoo")   # PSE Composite Index
usdphp_raw <- safe_get("PHP=X",   "yahoo")   # USD/PHP exchange rate (PHP per USD)
bdo_px    <- price_series(bdo_raw)
psei_px   <- price_series(psei_raw)
usdphp_px <- price_series(usdphp_raw)
vix_raw <- safe_get("VIXCLS",      "FRED")   # CBOE VIX, daily close
wti_raw <- safe_get("DCOILWTICO",  "FRED")   # WTI crude oil, daily spot
tibble(
Series = c("BDO.PS", "PSEI.PS", "PHP=X", "VIXCLS", "DCOILWTICO",
"BSP RRP rate", "PH 10Y yield", "PH CPI", "PH M3",
"OFW remittances", "Manufacturing production"),
Typical_Frequency = c(rep("Daily", 5), rep("Monthly (or event-based)", 6)),
Monthly_Rule = c("Last trading day", "Last trading day", "Monthly average",
"Monthly average", "Monthly average",
"Month-end", "Month-end", "Monthly level",
"Monthly level", "Monthly level", "Monthly level")
) |>
cobalt_kable(caption = "Source Frequency and Monthly Aggregation Rule")
